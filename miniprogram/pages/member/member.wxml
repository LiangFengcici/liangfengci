<view class="hero" style="padding:40rpx 32rpx 70rpx">
  <view class="row">
    <text class="hi">{{member ? member.level : '普通'}}会员</text>
    <text class="hi">{{member ? member.points : 0}} 积分</text>
  </view>
  <view class="title">{{member ? member.level : '普通'}} · 全机构通用权益</view>
  <view class="allergy">储值余额 {{member ? member.balanceText : '¥0.00'}}</view>
</view>

<view class="wrap" style="margin-top:-46rpx">
  <view class="card">
    <view class="row"><text class="card-title" style="margin:0">积分规则</text><text class="muted">1 元 = 1 分</text></view>
    <view class="rule">实付 1 元 = 1 分，100 分 = 1 元，抵扣不超过订单金额的 10%，退款时积分按比例扣回。</view>
  </view>

  <view class="card">
    <text class="card-title">优惠券（{{coupons.length}}）</text>
    <view class="list-item" wx:for="{{coupons}}" wx:key="code">
      <view class="row">
        <view>
          <view class="t">{{item.title}}</view>
          <view class="d">{{item.code}} · 适用 {{item.scope}} · 至 {{item.expire_at}}</view>
        </view>
        <view style="text-align:right">
          <view class="price">{{item.amountText}}</view>
          <text class="badge {{item.status === '未使用' ? 'green' : ''}}">{{item.status}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!coupons.length}}">暂无优惠券</view>
  </view>

  <view class="card">
    <text class="card-title">我的服务</text>
    <view class="list-item" bindtap="goBills">
      <view class="t">我的账单</view>
      <view class="d">结算单明细、分期期款{{unpaid ? ' · ' + unpaid + ' 张待支付' : ''}}</view>
    </view>
    <view class="list-item" bindtap="goReport">
      <view class="t">报告与影像</view>
      <view class="d">牙位记录、影像索引与知情同意</view>
    </view>
  </view>
</view>
