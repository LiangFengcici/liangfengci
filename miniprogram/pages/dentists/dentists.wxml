<view class="wrap">
  <view class="steps">
    <text class="s">1 项目</text><text class="s on">2 医生</text>
    <text class="s">3 时段</text><text class="s">4 确认</text><text class="s">5 支付</text>
  </view>

  <view class="card">
    <text class="label">就诊日期</text>
    <scroll-view scroll-x class="chips">
      <text class="chip {{item.date === date ? 'on' : ''}}" wx:for="{{dates}}" wx:key="date"
            data-date="{{item.date}}" bindtap="pickDate">{{item.label}} {{item.week}}</text>
    </scroll-view>
    <view class="rule">医生列表按“资质覆盖 × 当日已发布班次余量”过滤，与前台到店预约共用同一套口径。</view>
  </view>

  <view class="card" wx:for="{{cands}}" wx:key="dentist_id">
    <view class="row">
      <view>
        <view class="t">{{item.name}} <text class="muted">{{item.title}}</text></view>
        <view class="d">{{item.qualsText}}</view>
        <view class="d">最早可约 {{item.earliest}} · {{item.clinic_name}}</view>
      </view>
      <view style="text-align:right">
        <text class="badge teal">{{item.free_windows}} 个时段</text>
        <button class="btn small" style="margin-top:12rpx" data-item="{{item}}" bindtap="goSlots">选时段</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !cands.length}}">当天没有满足资质与档期的医生，换一天试试</view>
</view>
